# API Keys - Get these from respective providers
GROQ_API_KEY=your-groq-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:h2:mem:hms_db
